# --- Supabase Arka Uç Bağlantısı (PostgreSQL Veritabanı + Supabase Storage) ---
# Supabase Dashboard > Project Settings > API bölümünden alınır.
# Boş bırakılırsa yerel D1 (SQLite) veritabanı kullanılır veya uygulama içinden Ayarlar ekranından bağlanabilir.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# --- Yapay zekâ (tüm kullanıcılar bu anahtarı paylaşır; günlük haklarla sınırlıdır) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
# Kişi başı günlük haklar (boş bırakılırsa: çözüm 20, not 3, rapor 2, video yenileme 15). 0 = kapalı.
AI_LIMIT_SOLVE=
AI_LIMIT_NOTE=
AI_LIMIT_REPORT=
AI_LIMIT_VIDEO=
AI_LIMIT_QUOTE=
AI_LIMIT_PLAYLIST=

# --- Hesaplar ---
# Yöneticiler (sınırsız hak). Virgülle ayır. Boşsa sistemde ilk açılan hesap yöneticidir.
ADMIN_EMAILS=
# Yeni kayıtları kapatmak için false yaz.
REGISTRATION_OPEN=
# Uygulamanın genel adresi (Google dönüş adresi için). Boşsa isteğin adresi kullanılır.
APP_URL=

# --- Google ile giriş (isteğe bağlı) ---
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application)
# Yetkili yönlendirme URI'si: <APP_URL>/api/auth/google/callback  (yerelde http://localhost:5173/api/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Apple ile giriş (isteğe bağlı; dördü birden tanımlıysa düğme görünür) ---
# Apple Developer > Certificates, Identifiers & Profiles:
#  - Services ID oluştur (Sign in with Apple açık): APPLE_CLIENT_ID budur (örn. com.ornek.netudu.web)
#  - Services ID > Configure: Domain = alan adın, Return URL = <APP_URL>/api/auth/apple/callback (yalnız https)
#  - Keys > yeni anahtar (Sign in with Apple): Key ID = APPLE_KEY_ID, indirilen .p8 dosyası = APPLE_PRIVATE_KEY
#  - APPLE_TEAM_ID: hesap sayfandaki 10 haneli Team ID
# APPLE_PRIVATE_KEY: .p8 dosyasının tam içeriği (tek satırda yazıyorsan satır sonlarını \n yaz). Bu değeri kimseyle paylaşma.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# --- İsteğe bağlı: YouTube Data API v3 (yoksa anahtarsız arama kullanılır) ---
YOUTUBE_API_KEY=
